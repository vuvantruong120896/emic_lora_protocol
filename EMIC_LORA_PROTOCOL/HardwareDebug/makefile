-include ../makefile.defs

# Add inputs and outputs from these tool invocations to the build variables
LINKER_OUTPUT_OUTPUTS += \
EMIC_LORA_PROTOCOL.abs

LIBRARY_GENERATOR_OUTPUTTYPE_OUTPUTS += \
EMIC_LORA_PROTOCOL.lib

CONVERTOR_OUTPUT_OUTPUTS += \
EMIC_LORA_PROTOCOL.mot

OBJS := \
$(COMPILER_OBJS) \
$(INDIVIDUAL_COMPILER_OBJS) \
$(ASSEMBLER_OBJS) \
$(CUSTOM_OBJS)

$(COMPILER_OBJS): $(SMS_ASSEMBLER_H)

# All Target
all: EMIC_LORA_PROTOCOL.x EMIC_LORA_PROTOCOL.udm $(CONVERTOR_OUTPUT_OUTPUTS) 
	@echo 'Build complete.'

EMIC_LORA_PROTOCOL.mot: $(LINKER_OUTPUT_OUTPUTS) 
	@echo 'Invoking Converter: $@'
	rlink "EMIC_LORA_PROTOCOL.abs" -subcommand="ConverterEMIC_LORA_PROTOCOL.tmp"


EMIC_LORA_PROTOCOL.abs: $(LIBRARY_GENERATOR_OUTPUTTYPE_OUTPUTS) $(OBJS) $(ALL_ASMS)
	@echo 'Invoking Linker: $@'
	rlink -subcommand="LinkerEMIC_LORA_PROTOCOL.tmp"


EMIC_LORA_PROTOCOL.lib: 
	@echo 'Invoking Library Generator: $@'
	lbgrl -subcommand="LibraryGeneratorEMIC_LORA_PROTOCOL.tmp"

EMIC_LORA_PROTOCOL.x: EMIC_LORA_PROTOCOL.abs
	renesas_cc_converter EMIC_LORA_PROTOCOL.abs EMIC_LORA_PROTOCOL.x

EMIC_LORA_PROTOCOL.udm: $(LINKER_OUTPUT_OUTPUTS) $(CONVERTOR_OUTPUT_OUTPUTS)
	udcollector -subcommand=udSubcommand.tmp -output=EMIC_LORA_PROTOCOL.udm

# Other Targets
clean:
	-$(file > clean_file.tmp, $(LINKER_OUTPUT_OUTPUTS) $(LIBRARY_GENERATOR_OUTPUTTYPE_OUTPUTS) $(CONVERTOR_OUTPUT_OUTPUTS) $(SMS_ASSEMBLER_H) $(OBJS) $(C_DEPS) $(CPP_DEPS) $(ASM_DEPS) $(DSP_DEPS) $(OUTPUT_FILES))
	-@ xargs -P 2 -s 26000 -t -a clean_file.tmp $(RM)
	-@$(RM) clean_file.tmp
	@echo ''
	@echo 'Clean complete.'

.PHONY: all clean 
-include ../makefile.targets
.NOTPARALLEL: $(SMS_ASSEMBLER_H)

.SILENT: